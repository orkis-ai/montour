# =============================================================
# MonTour — variables d'environnement (copier en .env / configurer sur Vercel)
# =============================================================

# ── Indispensables en production ─────────────────────────────
# Clé secrète Django : sert à signer les JWT. Générer une valeur aléatoire longue :
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Base PostgreSQL. Sans elle, sur Vercel, SQLite est écrit dans /tmp et les
# comptes/tickets sont PERDUS à chaque redémarrage (voir /api/health/).
DATABASE_URL=

# Envoi des emails (confirmation d'adresse, mot de passe oublié).
# Sans SMTP, aucun email n'est délivré. Exemple Gmail : mot de passe d'application.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=MonTour <noreply@montour.bj>

# ── Domaine ──────────────────────────────────────────────────
# URL publique de l'app (sans slash final). Utilisée dans les liens des emails, ajoutée
# à ALLOWED_HOSTS et à CORS. Sur Vercel elle est déduite du domaine de production ;
# à renseigner si vous utilisez un domaine personnalisé.
FRONTEND_URL=https://votre-domaine.example

# ── Optionnel ────────────────────────────────────────────────
# Hôtes supplémentaires autorisés (séparés par des virgules).
# Par défaut : localhost,127.0.0.1,.vercel.app (+ le domaine de FRONTEND_URL).
ALLOWED_HOSTS=
# Origines CORS autorisées en production (l'app web même-origine n'en a pas besoin).
CORS_ALLOWED_ORIGINS=
# DEBUG : True par défaut en local, False par défaut sur Vercel.
DEBUG=

# ── SMS de rappel « votre tour approche » (eSMS Africa) ──────
# Un SMS part quand il reste au plus SMS_APPROACH_THRESHOLD personnes devant l'usager
# (une seule fois par ticket), et un autre quand son tour arrive. Sans clé API, RIEN n'est
# envoyé (les tentatives restent visibles dans l'admin Django > SMS).
# Clé : tableau de bord eSMS Africa > Developers > API Keys (esms_live_… ; les clés esms_test_…
# n'envoient pas de vrais SMS). Attention : les noms de variables sont sensibles à la casse
# (le code accepte ESMS_API_KEY et esms_API_KEY).
ESMS_API_KEY=
# Nom d'expéditeur affiché. Au Bénin il doit être enregistré au préalable chez eSMS Africa ;
# vide = expéditeur par défaut du compte.
ESMS_SENDER_ID=
ESMS_BASE_URL=https://sms.esmsafrica.io/api
SMS_ENABLED=True
SMS_PROVIDER=                      # esms | console (dev : le SMS s'affiche dans la console) ; vide = automatique
SMS_APPROACH_THRESHOLD=2
SMS_TIMEOUT=5
# Numérotation béninoise à 10 chiffres (+229 01XXXXXXXX) depuis le 30/11/2024.
SMS_BENIN_TEN_DIGITS=True
